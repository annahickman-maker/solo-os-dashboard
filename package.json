{
  "name": "solo-os-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Solo OS: a self-hosted dashboard for solo creators. Focus, content, brand, memory, library, contacts, pipeline, email, sales and analytics, with agent oversight.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "opennextjs-cloudflare build",
    "dev": "next dev -p ${PORT:-3001}",
    "start": "next start",
    "lint": "eslint",
    "test:crm": "node --experimental-strip-types --test src/lib/crm/*.test.ts",
    "test:social": "node --experimental-strip-types --test src/lib/social/*.test.ts",
    "test:social-upload": "node --experimental-strip-types --test src/lib/social/youtube.test.ts",
    "test:brand": "node --experimental-strip-types --test src/lib/brand/*.test.ts",
    "test:focus": "node --experimental-strip-types --test src/components/focus/*.test.ts src/components/offer/*.test.ts",
    "test:reputation": "node --experimental-strip-types --test src/lib/reputation/*.test.ts src/components/reputation/types.test.ts",
    "test:studio": "node --experimental-strip-types --test src/app/api/studio/*.test.ts",
    "test:home": "node --experimental-strip-types --test src/lib/analytics/*.test.ts src/lib/home/*.test.ts",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "test:money": "node --experimental-strip-types --test src/lib/money/*.test.ts src/lib/crm/fulfilment.test.ts",
    "test:agent-keys": "node --experimental-strip-types --test src/lib/api/*.test.ts",
    "test:library": "node --experimental-strip-types --test src/lib/library/*.test.ts",
    "test:events": "node --experimental-strip-types --test src/lib/events/*.test.ts",
    "test:memory": "node --experimental-strip-types --test src/components/memory/*.test.ts src/lib/memory/*.test.ts scripts/test-memory-import.mjs",
    "test:mcp": "node --experimental-strip-types --test src/lib/mcp/*.test.ts src/lib/mcp/tools/*.test.ts src/lib/agent/*.test.ts",
    "test:schema-types": "node --test scripts/test-schema-types.mjs",
    "test:db": "node --test scripts/test-db-tools.mjs scripts/test-schema-types.mjs",
    "test:db-local": "node --test scripts/test-pg-local.mjs",
    "db:install": "node scripts/install-db.mjs",
    "db:migrate": "node scripts/migrate.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@base-ui/react": "^1.3.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@opennextjs/cloudflare": "^1.19.5",
    "@supabase/ssr": "~0.9.0",
    "@supabase/supabase-js": "~2.99.1",
    "@tiptap/extension-link": "^3.20.5",
    "@tiptap/pm": "^3.20.5",
    "@tiptap/react": "^3.20.5",
    "@tiptap/starter-kit": "^3.20.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.7.0",
    "marked": "^16.4.2",
    "next": "^16.2.4",
    "openai": "^6.32.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "shadcn": "^4.1.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.4",
    "pg": "^8.22.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.86.0"
  }
}
